# Copy to .env and adjust. Never commit .env.

# --- Gateway ---
GATEWAY_PORT=8080
LOG_LEVEL=info
UPSTREAM_TIMEOUT_SECONDS=30
# Number of reverse proxies in front of the gateway whose X-Forwarded-For entries are trusted
TRUSTED_PROXY_COUNT=0
# The protected AI application (mock-ai in the local stack)
UPSTREAM_AI_URL=http://localhost:19000
# Separate credential for the admin API (min 8 chars)
ADMIN_API_KEY=change-me-admin-key
# Optional: a caller key created at startup if missing (cmpsk_<10 hex>_<secret>; only its hash is
# stored) — hand CMP its key through a secret store instead of an admin call.
# BOOTSTRAP_API_KEY=cmpsk_0123456789_replace-with-a-long-random-secret
BOOTSTRAP_API_KEY_NAME=cmp
BOOTSTRAP_API_KEY_SCOPES=inspect,outbound

# --- CMP sessions (one session = one Amazon Connect contact) ---
SESSION_TTL_SECONDS=86400             # session attributes kept this long after the last call
IDEMPOTENCY_TTL_SECONDS=600           # same message_id within this window → the cached decision
IDENTITY_HASH_KEY=change-me-identity-hash-key   # HMAC key for customer ids / identifiers; changing it resets per-customer history
CMP_HANDOFF_AFTER_BLOCKS=2            # the Nth blocked message of a session → handoff_to_agent
CMP_SHORT_BAN_SECONDS=900             # bans ending sooner → retry_later; longer ones → end_contact

# --- Host ports published by docker compose (in-container ports stay 6379/5432/8000/9000/8080) ---
HOST_REDIS_PORT=16379
HOST_POSTGRES_PORT=15432
HOST_ML_PORT=18000
HOST_MOCK_AI_PORT=19000
HOST_GATEWAY_PORT=18080
HOST_PROMETHEUS_PORT=19090           # observability profile only
HOST_GRAFANA_PORT=13000              # observability profile only

# --- Stores, for running the gateway outside docker (compose overrides these) ---
REDIS_URL=redis://localhost:16379
DATABASE_URL=postgresql://sec:sec@localhost:15432/security

# --- ML service ---
ML_URL=http://localhost:18000
ML_TIMEOUT_MS=150
ML_MAX_CONCURRENCY=64
# What to do when the ML tier times out or is down: allow | restrict | block
ML_FAILURE_MODE=restrict

# --- Limits ---
MAX_PROMPT_CHARS=4000
CHANNEL_MAX_CHARS=sms:1600,facebook:2000   # stricter per-channel limits (MAX_PROMPT_CHARS stays the ceiling)
CONVERSATION_ENABLED=true             # multi-turn analysis, keyed by the CMP session id
CONVERSATION_WINDOW=10                # turns remembered per session
CONVERSATION_TTL_SECONDS=3600         # memory expires after this long without a turn
CONV_TURN_CHARS=500                   # characters of each turn kept in Redis (window re-score)
CONV_WINDOW_TURNS=4                   # turns joined and re-scored (split payloads)
CONV_WINDOW_ML_ACTION=off             # ML on the joined window: off|restrict|block (rules on it always run)
CONV_WINDOW_LIFT=0.55                 # window must beat its best single turn by this much
CONV_DECAY=0.75                       # accumulated risk: acc = decay*acc + max(0, score - floor)
CONV_FLOOR=0.3
CONV_RESTRICT_AT=1.0
CONV_BLOCK_AT=2.0
CONV_SETUP_TURNS=5                    # "from now on ..." arms the conversation for N turns
CONV_SETUP_BOOST=2.0
CONV_CRESCENDO_BONUS=0.15
CONV_RETRY_SIMILARITY=0.85            # cosine to an earlier blocked turn = retry
CONV_MAX_BLOCKS=3                     # blocked turns before the conversation is locked
CONV_LOCK_ACTION=restrict

# --- Privacy ---
STORE_REDACTED_EXCERPT=true

# --- Auth cache ---
AUTH_CACHE_TTL_SECONDS=30
AUTH_NEGATIVE_CACHE_TTL_SECONDS=5

# --- Request limits ---
MAX_BODY_BYTES=262144

# --- Rate limiting (token buckets: CAPACITY = burst, REFILL = sustained requests/second) ---
RATE_LIMIT_FAILURE_MODE=open          # open = allow if Redis is down; closed = throttle
# Failure policy: a sensitive endpoint whose Redis-backed checks or session record were unavailable
SENSITIVE_ENDPOINTS=booking*,refund*,payment*,account*   # globs (a policy can also set sensitive: true)
DEGRADED_SENSITIVE_ACTION=restrict    # allow | restrict | block
# Identifier enumeration: many different booking refs / tickets / Aeroplan numbers in a short time
ENUM_ENABLED=true
ENUM_TYPES=booking_ref,ticket,aeroplan
ENUM_WINDOW_SECONDS=600
ENUM_SESSION_RESTRICT_AT=4            # distinct identifiers in one chat → restrict (no lookups)
ENUM_SESSION_BLOCK_AT=8               # … → block + a probabilistic strike (never bans the chat)
ENUM_IP_RESTRICT_AT=12                # distinct identifiers from one unshared IP, across chats → restrict
RL_IP_CAPACITY=60
RL_IP_REFILL_PER_SEC=1
RL_USER_CAPACITY=30
RL_USER_REFILL_PER_SEC=0.5
RL_API_KEY_CAPACITY=2000
RL_API_KEY_REFILL_PER_SEC=200
RL_SESSION_CAPACITY=20                # one chat: a burst of 20 messages…
RL_SESSION_REFILL_PER_SEC=0.2         # …then one every 5 seconds
RL_GLOBAL_CAPACITY=10000              # the whole gateway, all callers
RL_GLOBAL_REFILL_PER_SEC=1000
RL_ENDPOINT_CAPACITY=5000
RL_ENDPOINT_REFILL_PER_SEC=500

# --- Reputation (0-100, halves every half-life) ---
REPUTATION_HALF_LIFE_SECONDS=21600
REPUTATION_RESTRICT_AT=60

# --- Strikes and bans ---
STRIKE_WINDOW_SECONDS=2592000          # strikes count for 30 days
BAN_LADDER_SECONDS='[60,900,86400]'      # auto-ban length for strike 1, 2, 3+ (JSON list)
PERMANENT_AFTER_STRIKES=4              # ...and only with deterministic evidence
THROTTLE_STRIKE_COUNT=30               # throttles within the window that count as one strike
THROTTLE_STRIKE_WINDOW_SECONDS=60
AUTH_FAIL_STRIKE_COUNT=20              # failed logins from one IP that count as one strike
AUTH_FAIL_WINDOW_SECONDS=300
BAN_CACHE_REFRESH_SECONDS=30
# Shared IPs (Wi-Fi, carrier NAT): attacks are charged to the user / device, not the IP.
SHARED_IP_MIN_USERS=3                 # distinct users with allowed traffic (24 h) that make an IP "shared"
SHARED_IP_RATE_MULTIPLIER=10          # a shared IP's rate-limit bucket is this much larger
IP_ATTACKERS_FOR_STRIKE=3             # different identities attacking from a non-shared IP → strike the IP
IP_BAN_NEVER_PERMANENT=true           # automatic IP bans stop at 24 h (addresses get reassigned)
NEVER_BAN_CIDRS=127.0.0.0/8,::1/128,192.168.65.0/24    # never auto-banned: CMP's own servers, shared NATs (192.168.65.x = Docker Desktop host, i.e. local tests)

# --- Detection (Stage 4) ---
RULES_ENABLED=true
ALLOWED_LINK_DOMAINS=aircanada.com,aircanada.ca,aeroplan.com,flyaircanada.com
MAX_LINKS=5
ML_ENABLED=true
ML_KEEP_WARM_SECONDS=10                # ping the ML service when idle so the first call isn't cold
ML_USE_MODEL_THRESHOLDS=true           # use the model's calibrated block/restrict thresholds
ML_BLOCK_AT=0.9                        # fallback / pinned: score that blocks (probabilistic strike)
ML_RESTRICT_AT=0.7                     # fallback / pinned: score that restricts
ML_MIN_CHARS=15                        # shorter texts skip the model (rules still run)

# Phrase rules block provisionally and strike only when the ML tier agrees; ML score below
# RULES_ML_CLEAR_BELOW softens the block to a restrict. Template tokens / hidden text always strike.
RULES_CORROBORATE_WITH_ML=true
RULES_ML_CLEAR_BELOW=0.3
FUSION_ENABLED=true                   # two weak rule families + ML near the restrict line → restrict
FUSION_ML_MARGIN=0.15
OFF_TOPIC_ACTION=flag                 # off | flag | restrict — assistant used for non-support tasks
UNTRUSTED_CONTENT_ACTION=restrict     # off | flag | restrict | block — injection in tool results / documents
SINGLE_SIGNAL_NO_STRIKE=ml,rules      # a lone probabilistic verdict from these blocks but never strikes
CONV_CRESCENDO_MODE=loose             # strict | loose
BOT_PROFILE_IP_FOR_SESSION_ONLY=true  # session-only requests are profiled by their IP as well

# --- sensitive data and outbound checks (Stage 7) ---
SENSITIVE_ENABLED=true
INBOUND_REDACT_TYPES=payment,secret,sin,ssn,passport   # redacted before the AI sees user text
OUTBOUND_ENABLED=true
OUTBOUND_ALWAYS_REDACT=payment,sin,ssn,passport,dob   # always redacted from AI replies
OUTBOUND_SECRET_ACTION=block                          # secret in a reply: block | redact
OUTBOUND_SCOPE_TYPES=email,phone,booking_ref,ticket,aeroplan   # authorized-data check
OUTBOUND_UNAUTHORIZED_ACTION=block                    # identifier outside the caller's scope: block | redact
OUTBOUND_UNSCOPED_ACTION=redact                       # no scope (no list, anonymous session): allow | redact | block
OUTBOUND_BULK_IDENTIFIERS=5                           # distinct identifiers that look like a record dump
OUTBOUND_MAX_CHARS=8000
OUTBOUND_STRIP_IMAGES=true
OUTBOUND_STRIP_UNKNOWN_LINKS=true
OUTBOUND_COMMITMENT_ACTION=restrict                   # promises of refunds/approvals in replies: off | flag | restrict
OUTBOUND_CREDENTIAL_REQUEST_ACTION=block              # reply asks for card/password/SIN: off | flag | block
OUTBOUND_INJECTION_ECHO_ACTION=block                  # reply carries an injection: off | flag | block
OUTBOUND_CODE_FENCE_FLAG=true                         # code blocks in replies are flagged
OUTBOUND_ENUM_ENABLED=true                            # out-of-scope identifiers counted per session across replies
PROMPT_LEAK_MIN_SHINGLES=3                            # shared 8-word runs with a registered prompt = leak
CANARY_CACHE_TTL_SECONDS=30

# --- bot detection and adaptive throttling (Stage 8) ---
BOT_ENABLED=true
BOT_UA_CHANNELS=web                   # channels where the user agent is the customer's browser
BOT_WINDOW_EVENTS=20                  # recent requests remembered per identity
BOT_REGULAR_CV=0.15                   # gap variation below this = on a timer
BOT_FAST_CPS=20                       # characters per second no person types
BOT_DUP_DISTANCE=12                   # SimHash bits apart that still count as the same message
BOT_DUP_COUNT=3
BOT_RATE_PER_MINUTE=20
BOT_CAMPAIGN_IDENTITIES=5             # identities sending the same message = a campaign
# Cloud/VPS ranges that add to the bot score (comma-separated CIDRs; empty = off)
BOT_HOSTING_CIDRS=
BOT_SUSPECT_AT=0.4                    # end-user buckets drain BOT_SUSPECT_COST× faster
BOT_SUSPECT_COST=3
BOT_LIKELY_AT=0.6                     # … BOT_LIKELY_COST× faster
BOT_LIKELY_COST=10
BOT_BLOCK_AT=0.8                      # throttled outright for BOT_COOLDOWN_SECONDS
BOT_COOLDOWN_SECONDS=30

# --- audit trail, policies, metrics (Stage 9) ---
AUDIT_ENABLED=true
AUDIT_STREAM=audit:events
AUDIT_STREAM_MAXLEN=100000
AUDIT_WORKER_ENABLED=true             # write the stream to security_events from this gateway
AUDIT_BATCH_SIZE=200
AUDIT_CLAIM_IDLE_SECONDS=30           # retry entries a crashed worker left unwritten
AUDIT_EXCERPT_CHARS=200               # redacted excerpt length (STORE_REDACTED_EXCERPT)
POLICY_CACHE_TTL_SECONDS=30
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Read-only database role Grafana uses for per-message panels (never sees API keys). Change it.
DASHBOARD_DB_PASSWORD=change-me-dashboard-reader
